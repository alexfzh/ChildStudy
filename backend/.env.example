# 复制此文件为 .env 并填入你的真实配置

# === 应用配置 ===
# APP_HOST=127.0.0.1 只本地访问；LAN 访问需改 0.0.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# === 数据库 ===
DATABASE_URL=sqlite+aiosqlite:///./data/childstudy.db

# === 多孩子上限 ===
MAX_CHILDREN=4

# === 文件上传 ===
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# === 多用户认证 (v1.6.0) ===
# 生产部署务必改成 32 字节以上随机字符串：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production-please-use-32-bytes-random
JWT_EXPIRE_SECONDS=86400

# CORS 白名单（逗号分隔）。LAN 访问场景追加后端 / 前端的 LAN IP，例如：
#   ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://192.168.1.100:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# === 登录防爆破 (v1.7.1，可选，有默认值) ===
# 同一来源 IP 连续失败达阈值 → 临时锁定（来源 IP 维度，不锁正常用户）
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15

# === IP 限流 (v1.7.4，可选，默认关闭) ===
# 公网暴露前务必启用；家庭 LAN 可保持 0。
# 含义：每个 IP 每分钟最多请求 /api/* 端点的次数（登录与健康检查豁免）。
# 推荐值：家庭 LAN 0（开发调试）；公网 60~120；限流示例：100。
# RATE_LIMIT_PER_MINUTE=0

# === CSV 导入行数上限 (v1.7.4，可选，默认 5000) ===
# 防止上传大文件含数万行把进程卡死。
# MAX_IMPORT_ROWS=5000

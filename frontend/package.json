{
  "name": "childstudy-frontend",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5173",
    "lint": "eslint . --ext .js,.vue --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.vue --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:routes": "python scripts/audit-routes.py",
    "audit:routes:strict": "python scripts/audit-routes.py --strict"
  },
  "dependencies": {
    "axios": "~1.20.0",
    "dayjs": "~1.11.23",
    "echarts": "~5.6.0",
    "element-plus": "~2.14.5",
    "pinia": "~2.3.1",
    "vue": "~3.5.41",
    "vue-echarts": "~7.0.3",
    "vue-router": "~4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "~5.2.4",
    "autoprefixer": "~10.5.4",
    "eslint": "~8.57.1",
    "eslint-config-prettier": "~9.1.0",
    "eslint-plugin-vue": "~10.10.0",
    "postcss": "~8.5.26",
    "prettier": "~3.3.3",
    "tailwindcss": "~3.4.19",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "~5.4.21"
  }
}
